# ===================================================================
# WhatsApp Broadcast Manager - Environment Configuration (.env)
# ===================================================================

# Server Port & Environment Mode
PORT=4000
NODE_ENV=development

# -------------------------------------------------------------------
# Primary Database (PostgreSQL / Supabase / Neon / Local PostgreSQL)
# Supports direct connection or PgBouncer/Supabase pooler on port 6543
# -------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opticalmanager_broadcast"
# Set DATABASE_SSL to 'true' for remote clouds or 'false' for local PostgreSQL
DATABASE_SSL=false
# Pool size limit (default 10)
DB_POOL_MAX=10

# -------------------------------------------------------------------
# Optional Optical CRM Database URL (for cross-database shop/customer sync)
# -------------------------------------------------------------------
CRM_DATABASE_URL="postgresql://postgres.cbedtpiipwhfilspjdot:Optical%40manager2026@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------------
# Redis / Upstash Connection for BullMQ & Safe Message Queuing
# -------------------------------------------------------------------
REDIS_URL="rediss://default:token@special-gull-125433.upstash.io:6379"
REDIS_HOST="special-gull-125433.upstash.io"
REDIS_PORT=6379
REDIS_PASSWORD="your_redis_password"
UPSTASH_REDIS_REST_URL="https://special-gull-125433.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# -------------------------------------------------------------------
# Single Sign-On (SSO) Shared Secret Key with CRM Frontend
# -------------------------------------------------------------------
BROADCAST_SSO_SECRET="optical-manager-broadcast-sso-secret-key-2026"

# -------------------------------------------------------------------
# Cloudflare R2 Object Storage (Media Uploads & Campaign Attachments)
# -------------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="opticalmanager-broadcast-media"
R2_PUBLIC_DOMAIN="https://pub-xxxxxx.r2.dev"

